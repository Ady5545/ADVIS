# Required by the existing ADVIS conversation core.
GEMINI_API_KEY=

# Private, persistent owner memory (server-side only; never prefix these with VITE_).
# Paste the Firebase service-account JSON as one environment-variable value.
FIREBASE_SERVICE_ACCOUNT_JSON=
# Optional when project_id is already present in the service-account JSON.
FIREBASE_PROJECT_ID=

# One-time device pairing. Use two different long random values.
ADVIS_OWNER_PAIRING_CODE=
ADVIS_OWNER_TOKEN_SECRET=

# Existing Android/mobile API protection (if the mobile client is used).
ADVIS_MOBILE_API_TOKEN=
